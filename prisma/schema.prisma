generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  // "F" | "M" — drives gendered titles and Hebrew grammatical agreement.
  gender       String?
  // UI language: "he" (default, RTL) or "en".
  locale       String   @default("he")
  // Experimental condition, assigned at registration and fixed for the study:
  // TITLES = full social app, SCORE_ONLY = own score but no titles/leaderboard,
  // LOG_ONLY = logging only. See src/lib/research.ts.
  condition    String   @default("TITLES")
  /// Optional self-set weekly target: "WORKOUTS" | "DAYS" | "EFFORT", with its value.
  goalType     String?
  goalValue    Int?
  createdAt    DateTime @default(now())

  workouts        Workout[]
  reactions       Reaction[]
  comments        Comment[]
  events          Event[]
  passwordResets  PasswordReset[]
  sentRequests    Friendship[] @relation("Requester")
  receivedRequests Friendship[] @relation("Addressee")
}

/// Research telemetry: what a participant SAW, which workouts alone can't tell us.
model Event {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DASHBOARD_VIEW | LEADERBOARD_VIEW | TITLE_CHANGE | WORKOUT_LOGGED
  type      String
  /// Small JSON blob of context, e.g. the title held at view time and the rank.
  meta      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Single-use password reset, issued by a researcher — no mail provider needed.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  duration  Int
  intensity String
  distanceKm Float?
  note      String?
  date      DateTime
  createdAt DateTime @default(now())
  reactions Reaction[]
  comments  Comment[]

  @@index([userId, date])
  @@index([createdAt])
}

/// A friend's comment on a workout. Capped short and deletable by its author.
model Comment {
  id        String   @id @default(cuid())
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([workoutId, createdAt])
}

/// A friend's reaction to a workout — the social loop the study is actually about.
/// One reaction per person per workout; changing emoji overwrites the old one.
model Reaction {
  id        String   @id @default(cuid())
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([workoutId, userId])
  @@index([workoutId])
}

model Friendship {
  id           String   @id @default(cuid())
  requesterId  String
  addresseeId  String
  requester    User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User     @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@unique([requesterId, addresseeId])
}
