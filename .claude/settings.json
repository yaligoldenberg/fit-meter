{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-env-access.js",
            "timeout": 10,
            "statusMessage": "Checking for .env access"
          }
        ]
      }
    ]
  }
}
